    "NSScreenCaptureUsageDescription" : {
      "comment" : "Permission descriptions",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mio benötigt die Bildschirmaufnahme-Berechtigung, um Screenshots aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mio needs screen recording permission to capture screenshots."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mio nécessite l’autorisation d’enregistrement de l’écran pour prendre des captures."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットを撮影するには画面収録の許可が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mio 需要屏幕录制权限来进行截图。"
          }
        }
      }
    },
    "NSUserNotificationsUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mio nutzt Mitteilungen, um abgeschlossene Aufnahmen zu bestätigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mio uses notifications to confirm captures are complete."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mio utilise des notifications pour confirmer la fin des captures."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャプチャ完了を知らせるために通知を使用します。"
