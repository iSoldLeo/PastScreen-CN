        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Pas d’analytique ni de suivi\n• Pas d’upload cloud\n• Pas de services tiers\n• Fonctionne uniquement en local"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 解析や追跡なし\n• クラウドへのアップロードなし\n• サードパーティなし\n• すべてローカル動作"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 无分析或追踪\n• 无云端上传\n• 无第三方服务\n• 仅本地运行"
          }
        }
      }
    },
