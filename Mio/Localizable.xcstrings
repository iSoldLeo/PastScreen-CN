    "settings.general.privacy.bullets": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• Keine Analysen oder Tracking\n• Keine Cloud-Uploads\n• Keine Drittanbieter\n• Läuft nur lokal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• No analytics or tracking\n• No cloud uploads\n• No third-party services\n• Runs locally only"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Pas d’analytique ni de suivi\n• Pas d’upload cloud\n• Pas de services tiers\n• Fonctionne uniquement en local"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• 解析や追跡なし\n• クラウドへのアップロードなし\n• サードパーティなし\n• すべてローカル動作"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "• 无分析或追踪\n• 无云端上传\n• 无第三方服务\n• 仅本地运行"
          }
        }
      }
    },
    "settings.general.privacy.description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mio sammelt nichts; alles bleibt auf Ihrem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mio collects nothing; everything stays on your Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mio ne collecte rien ; tout reste sur votre Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mio は何も収集せず、すべて Mac に残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mio 不收集任何数据，所有内容仅保存在你的 Mac 上。"
          }
        }
      }
    },
