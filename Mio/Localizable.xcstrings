    },
    "error.permissions_required.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mio benötigt die Berechtigung Bildschirmaufnahme, um Bildschirmfotos aufzunehmen.\n\nGehe zu Systemeinstellungen → Datenschutz & Sicherheit → Bildschirmaufnahme und erlaube Mio."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mio needs Screen Recording permission to capture.\n\nGo to System Settings → Privacy & Security → Screen Recording and allow Mio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mio a besoin de l’autorisation d’enregistrement d’écran pour capturer.\n\nAllez dans Réglages Système → Confidentialité et sécurité → Enregistrement de l’écran et autorisez Mio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mio でキャプチャするには画面収録の許可が必要です。\n\nシステム設定 → プライバシーとセキュリティ → 画面収録で Mio を許可してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mio 需要屏幕录制权限才能截图。\n\n前往“系统设置 → 隐私与安全性 → 屏幕录制”并允许 Mio。"
          }
        }
      }
    },
