    "settings.general.privacy.bullets" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Keine Analysen oder Tracking\n• Keine Cloud-Uploads\n• Keine Drittanbieter\n• Läuft nur lokal"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• No analytics or tracking\n• No cloud uploads\n• No third-party services\n• Runs locally only"
