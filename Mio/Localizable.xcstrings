    "settings.storage.save_to_file.help": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，截图仅复制到剪切板，不写入磁盘。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, captures go to the clipboard only and are not written to disk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、スクリーンショットはクリップボードにのみコピーされ、ディスクには書き込まれません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn deaktiviert, werden Aufnahmen nur in die Zwischenablage kopiert, nicht auf die Festplatte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : les captures vont uniquement dans le presse-papiers, jamais sur le disque."
          }
        }
      }
    }
