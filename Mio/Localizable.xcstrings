    "settings.section.storage.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wenn „Aufnahmen als Datei speichern“ deaktiviert ist, werden Aufnahmen nur in die Zwischenablage kopiert und nicht auf die Festplatte geschrieben." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "When “Save captures to file” is off, captures are only copied to the clipboard and never written to disk." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Lorsque « Enregistrer les captures en fichier » est désactivé, les captures sont uniquement copiées dans le presse-papiers et jamais écrites sur le disque." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「キャプチャをファイルに保存」をオフにすると、キャプチャはクリップボードにコピーされるのみで、ディスクには書き込まれません。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭「保存截图到文件」后，截图仅复制到剪切板，不写入磁盘。" } }
      }
    },
