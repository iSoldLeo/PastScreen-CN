    "settings.section.general.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke den Kurzbefehl, um den entsprechenden Aufnahmemodus in jeder App auszulösen. Die erweiterte Fensteraufnahme öffnet anschließend den Editor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press the shortcut to trigger the matching capture mode from any app. Advanced window capture opens the editor afterwards."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur le raccourci pour déclencher le mode de capture correspondant depuis n’importe quelle app. La capture de fenêtre avancée ouvre ensuite l’éditeur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットを押すと、どのアプリからでも対応するキャプチャモードが起動します。高度なウィンドウキャプチャは撮影後にエディタが開きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下快捷键即可在任意应用中触发对应的截图模式。高级窗口截图截完后会进入编辑器。"
          }
        }
      }
    },
